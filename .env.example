# ─────────────────────────────────────────────────────────────────────────────
# AMBU-U — Configuracion de Entorno
# Copia este archivo como ".env" y completa los valores marcados con [COMPLETAR]
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Ambu-U
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de Datos MySQL ──────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ambu_u
DB_USERNAME=root
DB_PASSWORD=        # [COMPLETAR] tu password de MySQL

# ─── Broadcasting & WebSockets (Laravel Reverb) ───────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=ambuu_app_id
REVERB_APP_KEY=ambuu_app_key_2024
REVERB_APP_SECRET=ambuu_app_secret_2024
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Cache, Colas y Sesion ────────────────────────────────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

# ─── DeepSeek AI (Analisis Clinico) ──────────────────────────────────────────
DEEPSEEK_API_KEY=               # [COMPLETAR] tu API Key de platform.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30

# ─── Mail (Opcional - para alertas de vencimiento) ───────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ambuu.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Redis (Opcional - para escalar Reverb y colas) ──────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
